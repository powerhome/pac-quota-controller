{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>powerhome/renovate-config:pac",
    "group:allNonMajor"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^charts/pac-quota-controller/values.yaml$/"],
      "matchStrings": ["repository:\\s*ghcr\\.io/powerhome/pac-quota-controller\\s*\\n\\s*tag:\\s*(?<currentValue>.+)"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/powerhome/pac-quota-controller"
    }
  ],
  "packageRules": [
    {
      "description": "Don't digest-pin the chart's own image: the custom manager for values.yaml can't write a digest, and that failure blocks the whole pin branch.",
      "matchPackageNames": ["ghcr.io/powerhome/pac-quota-controller"],
      "pinDigests": false
    }
  ]
}
