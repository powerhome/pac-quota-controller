{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>powerhome/renovate-config",
    "group:allNonMajor"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^charts/pac-quota-controller/values.yaml$/"],
      "matchStrings": ["repository:\\s*ghcr\\.io/powerhome/pac-quota-controller\\s*\\n\\s*tag:\\s*(?<currentValue>.+)"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/powerhome/pac-quota-controller"
    }
  ],
  "packageRules": [
    {
      "description": "Don't digest-pin the chart's own image: the custom manager for values.yaml can't write a digest, and that failure blocks the whole pin branch.",
      "matchPackageNames": ["ghcr.io/powerhome/pac-quota-controller"],
      "pinDigests": false
    },
    {
      "description": "Upgrade Go in one PR: go.mod, setup-go and the golang image move together.",
      "matchDepNames": ["go", "golang"],
      "groupName": "go version",
      "commitMessageTopic": "Go"
    },
    {
      "description": "Bump the go.mod go directive too; by default Renovate leaves it behind.",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump"
    }
  ]
}
